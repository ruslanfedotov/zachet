<Window x:Class="ConverterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конвертер" Height="400" Width="400">

    <StackPanel Margin="20">
        <TextBlock Text="Конвертер величин" FontSize="20" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,20"/>

        <TextBox x:Name="txtValue" Height="35" Margin="0,5"/>

        <ComboBox x:Name="cmbType" Margin="0,10" Height="30">
            <ComboBoxItem Content="Метры → Километры" IsSelected="True"/>
            <ComboBoxItem Content="Километры → Метры"/>
            <ComboBoxItem Content="Цельсий → Фаренгейт"/>
            <ComboBoxItem Content="Фаренгейт → Цельсий"/>
        </ComboBox>

        <Button x:Name="btnConvert" Content="Конвертировать" Click="BtnConvert_Click" Height="40" Margin="0,10" FontWeight="Bold"/>

        <Border Background="#F0F0F0" Padding="10">
            <TextBlock x:Name="tbResult" Text="-" FontSize="16" TextAlignment="Center"/>
        </Border>
    </StackPanel>
</Window>